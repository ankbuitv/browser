{
  "name": "aurelia-browser-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Aurelia Browser - an original, privacy-oriented Chromium fork (workspace root for Aurelia-owned components, tooling and documentation).",
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && node tools/ci/fast-checks.mjs",
    "ui-lab": "npm run dev --workspace @aurelia/ui-lab",
    "chromium:status": "node tools/chromium/cli.mjs status",
    "chromium:check-updates": "node tools/chromium/cli.mjs check-updates",
    "chromium:plan": "node tools/chromium/cli.mjs plan",
    "patches:verify": "node tools/chromium/cli.mjs verify-patches",
    "patches:list": "node tools/chromium/cli.mjs list-patches"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ankbuitv/browser.git"
  },
  "homepage": "https://github.com/ankbuitv/browser",
  "bugs": {
    "url": "https://github.com/ankbuitv/browser/issues"
  }
}
