# Aurelia - retired LOW_RESOURCE_EXPERIMENT policy fixture (Windows x64).
#
# Retained only so repository tests can verify the historical GN argument
# policy. It is not used by the supported Chromium workflow and does not
# authorize compilation on local, self-hosted, or under-resourced machines.
# The only supported compile entry point is the manual GitHub-hosted workflow;
# it enforces the 8-core / 32-GB RAM / 150-GB free-disk gate independently.
#
# The values below are real upstream GN arguments at the configured Chromium
# pin and contain no security-weakening switch. Keep this fixture for policy
# regression checks, not as a build configuration.

is_debug = false
is_official_build = false
is_component_build = true
symbol_level = 0
concurrent_links = 1
treat_warnings_as_errors = false
target_cpu = "x64"
