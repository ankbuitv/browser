import "//chrome/browser/ui/webui/webui.gni"
import "//chrome/common/webui_url_constants.h"
import "//ui/webui/mojo_web_ui_controller.gni"

# New Tab WebUI controller
# STATUS: SCAFFOLDED - GN target written, not compiled yet.
webui_controller("newtab") {
  name = "newtab"
  controller_class = "NewTabUI"
  controller_header = "newtab_ui.h"
  controller_source = "newtab_ui.cc"
  config_name = "NewTabUIConfig"
  webui_host = kChromeUINewTabAureliaHost
  webui_type = DEFAULT_INTERNAL

  # Resources
  resources = [ "//chrome/browser/resources/newtab" ]

  # Dependencies
  deps = [
    "//chrome/browser/profiles",
    "//chrome/browser/ui/webui",
    "//chrome/common/webui_url_constants",
    "//content/public/browser",
    "//services/network/public/mojom:content_security_policy",
    "//ui/webui",
  ]
}
